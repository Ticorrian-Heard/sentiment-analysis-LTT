# Do not expose your credentials to the client, when using the Video SDK in production please make sure to use a backend service to sign the tokens. Don't store credentials in plain text, as this is a sample app we're using an `.env` for sake of simplicity.

# Your Zoom SDK Key
ZOOM_SDK_KEY=
# Your Zoom SDK Secret
ZOOM_SDK_SECRET=
# Port for the token server (server.ts), defaults to 3000 if unset
PORT=3000

# URL of the token server (server.ts) used by the frontend to fetch a JWT.
# Must be prefixed with VITE_ so Vite exposes it to client-side code.
# Leave blank to fall back to the manual token prompt in the browser.
VITE_ENDPOINT_URL=http://localhost:3000
